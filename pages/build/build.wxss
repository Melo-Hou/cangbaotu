/* pages/build/build.wxss */
.pg { padding: 24rpx 28rpx 60rpx; }
.lead { font-size: 26rpx; color: #444441; line-height: 1.7; margin-bottom: 20rpx; }
.row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.btn { flex: 1; background: #e6f1fb; color: #185fa5; border-radius: 20rpx; font-size: 26rpx; padding: 8rpx 0; }
.btn.primary { background: #185fa5; color: #fff; margin-top: 8rpx; }
.btn.ghost { background: #f1efe8; color: #5f5e5a; margin-top: 12rpx; }
.btn.ok { background: #e1f5ee; color: #0f6e56; font-weight: 600; }
.btn[disabled] { opacity: 0.5; color: #fff; background: #185fa5; }
.pv { width: 100%; height: 300rpx; margin-top: 16rpx; background: #f1efe8; border-radius: 16rpx; }
.log { background: #faf9f6; border: 1rpx solid #e5e3dc; border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 16rpx; display: flex; flex-direction: column; gap: 6rpx; }
.ln { font-size: 22rpx; color: #5f5e5a; }
.draft { width: 100%; height: 445px; margin-top: 16rpx; background: #fbfaf7; border: 1rpx solid #e5e3dc; border-radius: 16rpx; }
.tip2 { font-size: 22rpx; color: #854f0b; text-align: center; margin-top: 10rpx; }
