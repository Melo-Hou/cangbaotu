<!--pages/map/map.wxml-->
<view class="page">
  <view class="searchrow">
    <input class="search" placeholder="搜物品或季节，如：手套 / 冬" bindinput="onSearch" value="{{query}}" />
    <view class="clearbtn" wx:if="{{query}}" bindtap="clearSearch">×</view>
  </view>

  <view class="results" wx:if="{{results.length}}">
    <view class="res-count">{{results.length}} 处命中，点击直达</view>
    <view class="res-item" wx:for="{{results}}" wx:key="key"
          bindtap="onResultTap"
          data-location-id="{{item.locationId}}" data-geo-id="{{item.geoId}}">
      <text>{{item.label}}</text>
      <text class="chev">›</text>
    </view>
  </view>

  <canvas id="map" type="2d" class="map" bindtouchstart="onTouchStart"></canvas>
  <view class="hint">点击家具下钻 · 搜索命中地图高亮</view>

  <!-- 底部下钻面板 -->
  <view class="mask" wx:if="{{sheet}}" bindtap="closeSheet"></view>
  <view class="sheet" wx:if="{{sheet}}">
    <view class="grab"></view>
    <view class="path">{{sheet.path}}</view>
    <view class="title">{{sheet.name}}</view>

    <view class="sec" wx:if="{{sheet.subs.length}}">子位置（点击继续下钻）</view>
    <view class="nav">
      <view class="navbtn" wx:for="{{sheet.subs}}" wx:key="id" bindtap="onSubTap" data-id="{{item.id}}">{{item.name}}</view>
    </view>

    <view class="sec" wx:if="{{sheet.items.length}}">存放物品（点击：取出 / 放回 / 删除）</view>
    <view class="item" wx:for="{{sheet.items}}" wx:key="id" bindtap="onItemTap" data-item="{{item}}">
      <text>{{item.name}} <text class="tag">{{item.seasonLabel}}</text> <text class="out" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</text></text>
      <text class="qty">×{{item.qty}}</text>
    </view>

    <view class="addrow">
      <view class="addbtn" bindtap="toggleAdd">＋ 添加物品</view>
      <view class="addbtn" bindtap="toggleSubAdd">＋ 添加子位置/箱子</view>
    </view>

    <view wx:if="{{adding}}" class="form">
      <input class="inp" placeholder="物品名称，如：手套" bindinput="onName" value="{{newName}}" />
      <view class="formline">
        <input class="inp qty-inp" type="number" bindinput="onQty" value="{{newQty}}" />
        <view class="ss {{newSeason === s.v ? 'on' : ''}}" wx:for="{{seasons}}" wx:for-item="s" wx:key="v"
              data-v="{{s.v}}" bindtap="pickSeason">{{s.l}}</view>
      </view>
      <view class="savebtn" bindtap="saveItem">保存物品</view>
    </view>

    <view wx:if="{{subAdding}}" class="form">
      <input class="inp" placeholder="子位置名，如：上层 / 蓝色收纳箱3号" bindinput="onSubName" value="{{subName}}" />
      <view class="savebtn" bindtap="saveSub">保存位置</view>
    </view>
  </view>
</view>
