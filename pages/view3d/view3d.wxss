/* pages/view3d/view3d.wxss */
.page3d { height: 100vh; display: flex; flex-direction: column; background: #f4f2ec; position: relative; }
.c3d { flex: 1; width: 100%; }
.reset { position: absolute; top: 20rpx; right: 20rpx; background: #fff; border: 1rpx solid #e5e3dc; border-radius: 24rpx; padding: 10rpx 24rpx; font-size: 24rpx; color: #185fa5; }
.tip { position: absolute; bottom: 24rpx; left: 0; right: 0; text-align: center; font-size: 20rpx; color: #a8a69d; }
.sheet3d { position: absolute; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 20rpx 32rpx 40rpx; }
.grab { width: 72rpx; height: 8rpx; background: #e5e3dc; border-radius: 4rpx; margin: 0 auto 20rpx; }
.path { font-size: 22rpx; color: #888780; }
.t { font-size: 32rpx; font-weight: 600; margin: 6rpx 0 12rpx; }
.sec { font-size: 22rpx; color: #888780; margin: 14rpx 0 8rpx; }
.item { display: flex; justify-content: space-between; border: 1rpx solid #e5e3dc; border-radius: 16rpx; padding: 14rpx 22rpx; margin-bottom: 10rpx; font-size: 26rpx; }
.qty { color: #5f5e5a; }
.empty { font-size: 24rpx; color: #a8a69d; padding: 8rpx 0; }
.close { text-align: center; color: #185fa5; font-size: 26rpx; padding: 12rpx 0 0; }
